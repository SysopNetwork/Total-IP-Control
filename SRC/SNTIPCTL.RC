/* SNTIPCTL.RC - Windows version resource for SNTIPCTL.DLL */
/* The version numbers come from SNTVER.H, the single source of truth. */

#include <windows.h>
#include "SNTVER.H"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SNTVER_NUMS
 PRODUCTVERSION  SNTVER_NUMS
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sysop Network"
            VALUE "FileDescription",  "Total IP Control for The Major BBS v10"
            VALUE "FileVersion",      SNTVER_DOTTED
            VALUE "InternalName",     SNTMODNAME
            VALUE "LegalCopyright",   SNTCOPYRIGHT
            VALUE "OriginalFilename", "SNTIPCTL.DLL"
            VALUE "ProductName",      SNTPRODUCT
            VALUE "ProductVersion",   SNTVER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
